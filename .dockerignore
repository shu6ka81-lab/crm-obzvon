# Секреты в образ не кладём. Раньше .env попадал в сборку через `COPY . .`,
# и значения из него подставлялись в код на этапе компиляции: ключ оказывался
# внутри образа, а не читался при запуске. Поменять его без пересборки было
# нельзя, а сам образ становился носителем секрета.
.env
.env.*
!.env.example

.git
.github
node_modules
.next
.pglite
dist-scripts
скриншоты
*.xlsx
*.md
